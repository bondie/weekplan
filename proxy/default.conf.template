server {
    listen 80 default_server;
    server_name _;

    # Only PUBLIC_* placeholders are substituted (NGINX_ENVSUBST_FILTER), nginx
    # variables below survive as-is.
    return 301 https://$host${PUBLIC_HTTPS_SUFFIX}$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name weekplan.localhost localhost;

    ssl_certificate /etc/nginx/certs/weekplan.localhost.pem;
    ssl_certificate_key /etc/nginx/certs/weekplan.localhost-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:2m;

    client_max_body_size 8m;

    location /api/ {
        proxy_pass http://api:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /healthz {
        proxy_pass http://api:3010/healthz;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://web:5180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
