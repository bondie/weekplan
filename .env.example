# --- JIRA (self-hosted Jira Server / Data Center, read-only access) ---
# If these are already exported in your shell (~/.zshrc), you do not need a .env file at all.
JIRA_URL=https://jira.example.com
JIRA_USERNAME=your.name@example.com
JIRA_PASSWORD=

# --- Overhead calendar (optional, can also be added later in the UI) ---
# Outlook Web -> Settings -> Calendar -> Shared calendars -> Publish -> copy the .ics link.
# Treat this URL as a secret: anyone who has it can read your calendar.
ICS_URL=

# --- Sync schedule (cron expressions) ---
JIRA_SYNC_CRON=*/5 * * * *
JIRA_FULL_SYNC_CRON=7 */6 * * *
CALENDAR_SYNC_CRON=*/30 * * * *

# --- Reverse proxy ---
# The app is served over HTTPS; plain HTTP only redirects to it.
# Ports below 1024 need Docker Desktop's privileged port mapping, see README.
PROXY_PORT=8090
PROXY_HTTPS_PORT=8443
# Leave empty when PROXY_HTTPS_PORT is 443, otherwise set the same port with a colon
# so the HTTP -> HTTPS redirect keeps it (e.g. ":8443").
PROXY_HTTPS_SUFFIX=:8443
